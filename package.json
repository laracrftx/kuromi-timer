{
  "name": "kuromi-timer",
  "version": "1.0.0",
  "description": "A Kuromi-themed Pomodoro timer for the desktop",
  "main": "src/main.js",
  "author": "you",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.yourname.kuromitimer",
    "productName": "Kuromi Timer",
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "mac": {
      "icon": "assets/icons/icon.icns",
      "category": "public.app-category.productivity"
    },
    "win": {
      "icon": "assets/icons/icon.ico"
    },
    "linux": {
      "icon": "assets/icons/icon.png",
      "category": "Utility"
    }
  }
}
